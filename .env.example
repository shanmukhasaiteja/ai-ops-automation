# --- service ---
WEBHOOK_SECRET=change-me          # HMAC key your webhook senders sign with
ADMIN_TOKEN=change-me-too         # for /events /metrics /digest/flush /deliveries/retry
OPS_DB=ops.db
OPS_DRY_RUN=1                     # 1 = record only, send nothing. Set 0 to go live.

# --- triage model (only for OPS_LLM=openai) ---
OPS_LLM=heuristic                 # heuristic | openai
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# --- destinations (unset ones are reported as "unconfigured") ---
PAGERDUTY_URL=https://events.pagerduty.com/v2/enqueue
PAGERDUTY_ROUTING_KEY=
SLACK_INCIDENTS_URL=
SLACK_TRIAGE_URL=
SLACK_DIGEST_URL=
TICKET_WEBHOOK_URL=
